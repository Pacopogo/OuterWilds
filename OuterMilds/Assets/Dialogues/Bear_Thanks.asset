  dialogue:
  - name: Bear
    text: Thanks to you, our forest is cleaner
    sprite: {fileID: 21300000, guid: d02d6e51257a1d34da53afe09a8d9e60, type: 3}
    typeSpeed: 7
    textColor: {r: 1, g: 1, b: 1, a: 1}
