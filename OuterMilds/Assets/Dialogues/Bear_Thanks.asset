        m_Calls: []
    EndDialogue:
      m_PersistentCalls:
        m_Calls: []
  - name: Bear
    text: As thanks I cleaned up these sticks that blocked off the rest of the forest
    sprite: {fileID: 21300000, guid: d02d6e51257a1d34da53afe09a8d9e60, type: 3}
    typeSpeed: 7
    textColor: {r: 1, g: 1, b: 1, a: 1}
    initalClip: {fileID: 8300000, guid: 8fee491c1d73c15409b20ee81753bfbe, type: 3}
    typeClip: {fileID: 8300000, guid: 8c319c77d1826634caba32554f08442a, type: 3}
    voiceLine: {fileID: 0}
    hasEvent: 0
    OnDialogue:
      m_PersistentCalls:
        m_Calls: []
    EndDialogue:
      m_PersistentCalls:
        m_Calls: []
  - name: Bear
    text: Please enjoy more nature
    sprite: {fileID: 21300000, guid: d02d6e51257a1d34da53afe09a8d9e60, type: 3}
